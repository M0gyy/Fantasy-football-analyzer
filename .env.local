# Yahoo Fantasy Sports API
# Register at: https://developer.yahoo.com/apps/create/
# Set redirect URI to: http://localhost:3000/auth/callback
# Permissions: Fantasy Sports - Read
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Session encryption secret - generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_32_char_hex_string_for_session_encryption

# App base URL (no trailing slash)
APP_URL=http://localhost:3000
